{
    "version": 4,
    "configurations": [
        {
            "name": "macOS OpenCV",
            "compilerPath": "/usr/bin/clang++",
            "intelliSenseMode": "macos-clang-arm64",
            "cStandard": "c17",
            "cppStandard": "c++17",
            "includePath": [
                "${workspaceFolder}",
                "/opt/homebrew/opt/opencv/include/opencv4"
            ],
            "browse": {
                "path": [
                    "${workspaceFolder}",
                    "/opt/homebrew/opt/opencv/include/opencv4"
                ],
                "limitSymbolsToIncludedHeaders": true
            }
        }
    ]
}
